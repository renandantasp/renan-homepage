---
import '../styles/global.css';
import { site } from '../data/site';

export interface Props {
  title?: string;
}

const { title = `${site.name} — ${site.title}` } = Astro.props;
const description = `${site.name} — ${site.title} based in ${site.base}. ${site.currently.role} at ${site.currently.company}.`;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: site.legalName,
  jobTitle: site.title,
  email: `mailto:${site.email}`,
  url: site.url,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'São Carlos',
    addressRegion: 'SP',
    addressCountry: 'BR',
  },
  worksFor: { '@type': 'Organization', name: site.currently.company },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Universidade Federal de São Carlos (UFSCar)',
  },
  sameAs: site.links.map((link) => link.href),
};
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#a3e635" />
		<meta name="generator" content={Astro.generator} />
		<meta property="og:type" content="profile" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={site.url} />
		<link rel="icon" type="image/svg+xml" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<script type="application/ld+json" set:html={JSON.stringify(person)} />
	</head>
	<body>
		<slot />
	</body>
</html>
